# replica-exchange settings
REXMD 20 1000 T 0.20 0.80
# the above line uses 4 replicas equally spaced from 0.10 to 0.50
# for "T"emperature REX MD, exchanges are attempted every 1000 steps

# file names for input files
COORDINATES start
SCALEDAT scale_RNA.dat
TOPOLOGY parameters.top
# output options
DUMPCOORDS 2000
DUMPENERGY 2000
# DUMPPDB 2000
RMSD 250 F
# simulation settings
MDMODE LD
TEMPERATURE 0.4
TIMESTEP 0.01
MDSTEPS 100000000
# initial minimisation
MININIT 20000 100 1.0D1
MINTRACK 100
# thermalisation
THERMALISATION 5 200
THERMALISE_OPTIONS 5 0 1 1000
